<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MagicCircle</AssemblyName>
    <RootNamespace>MagicCircle</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Yu Gothic UI, 9pt</ApplicationDefaultFont>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- エクスプローラー・タスクバー・Alt+Tab で使われる exe のアイコン -->
    <ApplicationIcon>magiccircle.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="gestures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- トレイアイコンは実行時に表示サイズに合うフレームを選ぶため、同じ .ico を埋め込む -->
    <EmbeddedResource Include="magiccircle.ico" />
  </ItemGroup>

</Project>
